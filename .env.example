# Provider resolution order is mlx → ollama → hosted → none (§9.0). Nothing
# here is required: with an empty file the app resolves to `none` and runs
# from the committed lesson bank, with the free-text interest field hidden.

# --- 0. MLX (our own quantized Qwen, Apple silicon) --------------------------
# Runs on localhost. Quantize once, then serve:
#   npm run llm:quantize   # Qwen2.5-1.5B-Instruct bf16 → 4-bit, into .models/
#   npm run llm:serve      # http://localhost:8080
#   npm run llm:bench      # writes eval/llm-bench.md
# MLX_MODEL is a folder under .models/, read by both llm:serve and the app.
# MLX_BASE_URL=http://localhost:8080
# MLX_MODEL=qwen2.5-1.5b-instruct-4bit
# MLX_TIMEOUT_MS=20000

# --- 1. Ollama (dev, and the recorded demo) ---------------------------------
# Runs on localhost. It does not exist on a deployed host.
#   ollama serve
#   ollama pull llama3.2:3b
# OLLAMA_MODEL must name a model you have. Check with `ollama list`.
# A larger model works but is slower; raise the timeout if you use one.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_TIMEOUT_MS=20000

# --- 2. Hosted (the deployed build) -----------------------------------------
# Any OpenAI-compatible /chat/completions endpoint. All three are required
# together; with any one missing the provider reports itself unavailable
# rather than failing at request time.
# HOSTED_LLM_BASE_URL=https://api.example.com/v1
# HOSTED_LLM_API_KEY=
# HOSTED_LLM_MODEL=

# --- Override ----------------------------------------------------------------
# Pin one provider instead of resolving in order. Useful for the eval.
# LLM_PROVIDER=ollama
